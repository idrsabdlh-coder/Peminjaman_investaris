# ==============================================================================
# Konfigurasi Lingkungan Sistem Peminjaman & Inventaris Tim IT (v5)
# Salin berkas ini ke .env dan sesuaikan nilainya di lingkungan Anda.
# JANGAN PERNAH mengomit berkas .env ke Git!
# ==============================================================================

# Port aplikasi backend Express
PORT=3001

# --- Basis Data MySQL (Aplikasi Sehari-hari / SYSTEM-DESIGN 6A.4) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventaris_it_dev
DB_USER=app_inventaris
DB_PASSWORD=GANTI_DENGAN_PASSWORD_APP

# --- Runner Migrasi Basis Data (Akun Migrator dengan hak DDL) ---
MIGRATE_DB_USER=migrator
MIGRATE_DB_PASSWORD=GANTI_DENGAN_PASSWORD_MIGRATOR

# --- Jalur mysqldump (Backup terjadwal & migrasi / Laragon) ---
# Sesuaikan versi MySQL pada folder Laragon Anda (mis. mysql-8.0.30-winx64)
MYSQLDUMP_PATH="C:\laragon\bin\mysql\mysql-8.0.30-winx64\bin\mysqldump.exe"

# ==============================================================================
# Variabel lama (prototipe, dihapus saat peralihan)
# ==============================================================================
# DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@localhost:5432/inventaris
# VITE_API_URL=http://localhost:3001/api
